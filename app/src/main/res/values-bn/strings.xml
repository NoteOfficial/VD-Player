    <string name="legal_2_title">২. অ্যাপ্লিকেশন লাইসেন্স</string>
    <string name="legal_2_body">VD Player ব্যক্তিগত ও বৈধ অফলাইন মিডিয়া ব্যবস্থাপনা, প্লেব্যাক ও অনুমোদিত ডাউনলোডের জন্য প্রদান করা হয়েছে।</string>
    <string name="legal_3_title">৩. গোপনীয়তা নীতি</string>
    <string name="legal_3_body">VD Player সম্পূর্ণ লোকাল-ফার্স্ট নীতিতে চলে। ডাউনলোড, গ্যালারি, ইতিহাস, বুকমার্ক ও AES-256-GCM ভল্ট ফাইল শুধুমাত্র আপনার ডিভাইসেই থাকে।</string>
    <string name="legal_4_title">৪. শর্তাবলি</string>
    <string name="legal_4_body">যেকোনো মিডিয়া ডাউনলোড বা সংরক্ষণের পূর্বে বৈধ অধিকার বা অনুমতি নিশ্চিত করা ব্যবহারকারীর নিজস্ব দায়িত্ব।</string>
    <string name="legal_5_title">৫. থার্ড-পার্টি ওপেন সোর্স লাইসেন্স</string>
    <string name="legal_6_title">৬. মিডিয়া প্রসেসিং ও স্ক্যানিং লাইব্রেরি লাইসেন্স</string>
    <string name="legal_7_title">৭. ডাউনলোড ব্যবহারের সতর্কবার্তা</string>
    <string name="legal_7_body">অনুমতি ছাড়া কপিরাইটযুক্ত ফাইল ডাউনলোড আইনত দণ্ডনীয় হতে পারে। শুধুমাত্র সরাসরি HTTPS ও অনুমোদিত মিডিয়া সমর্থিত।</string>
